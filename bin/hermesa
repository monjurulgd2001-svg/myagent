#!/usr/bin/env bash
# hermesa - send text / images / files / voice calls to the Hermesa app.
#
# FIX: the old version hardcoded the "hermesa-agent" skill folder, but the
# skill actually installs as "hermesa-phone" - so image/file sending died
# with "file not found". Now every known install location is searched.
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
for d in "$HOME/.hermes/hermes-agent/skills/hermesa-phone/scripts" \
         "$HOME/.hermes/skills/hermesa-phone/scripts" \
         "$HOME/.hermes/hermes-agent/skills/hermesa-agent/scripts" \
         "$HOME/.hermes/skills/hermesa-agent/scripts" \
         "$SELF_DIR/../skills/hermesa-phone/scripts"; do
  if [ -f "$d/hermesa_bot.py" ]; then
    exec python3 "$d/hermesa_bot.py" "$@"
  fi
done
echo "hermesa: hermesa_bot.py is not installed (searched hermesa-phone and hermesa-agent skill folders)" >&2
exit 1
