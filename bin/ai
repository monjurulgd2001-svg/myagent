#!/usr/bin/env python3
"""ai - switch the chat between the rotating pool and OpenRouter.

The NVIDIA+Mistral pool and OpenRouter are FULLY separate, never mixed:
  - default        : chat uses ONLY the NVIDIA+Mistral rotating pool
  - after `ai or X`: chat uses ONLY OpenRouter model X (keys still rotate)
A switch applies to the very next message - the router re-reads the mode
files on every request, no restart needed.

Usage:
  ai status                 show current mode + selected model
  ai or <model-id>          switch chat to ONLY this OpenRouter model
                            e.g.  ai or deepseek/deepseek-chat-v3-0324:free
  ai or                     switch to OpenRouter (panel-ticked models)
  ai pool                   switch back to the NVIDIA+Mistral pool (default)
  ai models                 list OpenRouter models ticked on the panel
"""
import json
import os
import sys

HOME = os.path.expanduser("~/.hermes")
MODE_FILE = os.path.join(HOME, "route_mode")
OR_MODEL_FILE = os.path.join(HOME, "openrouter_model")
POOL_FILE = os.path.join(HOME, "pool.json")
OR_LIST_FILE = os.path.join(HOME, "or_models.txt")  # panel's full OR list


def read(path, default=""):
    try:
        return open(path).read().strip()
    except Exception:
        return default


def write(path, value):
    os.makedirs(HOME, exist_ok=True)
    open(path, "w").write(value + "\n")


def pool_models(provider=None):
    try:
        items = json.load(open(POOL_FILE))
    except Exception:
        return []
    return [x["id"] for x in items
            if isinstance(x, dict) and x.get("id")
            and (provider is None or x.get("provider") == provider)]


def or_list():
    """Panel-ticked OpenRouter models + EVERYTHING typed in the panel's
    OpenRouter models box (or_models.txt), deduped, order preserved."""
    out = pool_models("openrouter")
    try:
        raw = open(OR_LIST_FILE).read()
    except Exception:
        raw = ""
    for line in raw.replace(",", "\n").splitlines():
        m = line.strip()
        if m and m not in out:
            out.append(m)
    return out


def status():
    mode = read(MODE_FILE, "pool") or "pool"
    if mode not in ("pool", "openrouter"):
        mode = "pool"
    if mode == "openrouter":
        m = read(OR_MODEL_FILE)
        print("mode: openrouter (chat uses ONLY OpenRouter)")
        print("model: " + (m or "(none picked - using panel-ticked OpenRouter models)"))
    else:
        n = len(pool_models("nvidia")) + len(pool_models("mistral"))
        print("mode: pool (default - chat uses ONLY the NVIDIA+Mistral pool)")
        print("pool models: %d" % n)
    print("switch: `ai or <model>` / back: `ai pool`")


def main(argv):
    cmd = (argv[1] if len(argv) > 1 else "status").lower()
    if cmd in ("status", "st"):
        status()
    elif cmd in ("pool", "default", "off"):
        write(MODE_FILE, "pool")
        print("switched -> pool (NVIDIA+Mistral only). Applies to the next message.")
    elif cmd in ("or", "openrouter"):
        model = argv[2].strip() if len(argv) > 2 else ""
        if model:
            write(OR_MODEL_FILE, model)
        write(MODE_FILE, "openrouter")
        if model:
            print("switched -> openrouter, ONLY model: " + model)
        else:
            keep = read(OR_MODEL_FILE)
            if keep:
                print("switched -> openrouter, ONLY model: " + keep
                      + "  (change: ai or <model>)")
            else:
                ors = or_list()
                print("switched -> openrouter (panel models: %d)." % len(ors))
                print("pick one specific model with: ai or <model-id>")
        print("Applies to the next message. Back: ai pool")
    elif cmd in ("models", "list", "ls"):
        ors = or_list()
        if not ors:
            print("no OpenRouter models on the panel yet - add some in"
                  " the OpenRouter models box and press Apply")
        for m in ors:
            print(m)
    else:
        print(__doc__.strip())
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
